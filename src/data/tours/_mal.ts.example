// 2. Fjern .example fra filnavnet
// 3. Fyll ut all informasjon under
// 4. Åpne src/data/tours/index.ts og:
//    - Importer turen: import minNyeTur from "./min-nye-tur";
//    - Legg til i tourModules-arrayen: [kristiansundByvandring, ..., minNyeTur]
// ============================================

